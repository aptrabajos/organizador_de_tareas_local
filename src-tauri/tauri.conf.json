{
  "productName": "Gestor de Proyectos",
  "version": "0.6.1",
  "identifier": "com.gestor.proyectos",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestor de Proyectos",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Ventana principal: dialogos nativos, atajos globales y escritura del markdown de backup en la carpeta que elige el usuario. El WebView no tiene lectura de filesystem.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "fs:deny-default",
            {
              "identifier": "fs:allow-write-text-file",
              "allow": [
                { "path": "$HOME/**" },
                { "path": "/mnt/**" },
                { "path": "/tmp/**" }
              ],
              "deny": [
                { "path": "$HOME/.ssh/**" },
                { "path": "$HOME/.gnupg/**" },
                { "path": "$HOME/.aws/**" },
                { "path": "$HOME/.config/**" },
                { "path": "$HOME/.local/share/**" }
              ]
            },
            "global-shortcut:allow-register",
            "global-shortcut:allow-unregister-all"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Gestor de Proyectos",
    "copyright": "Copyright © 2025. Todos los derechos reservados.",
    "category": "DeveloperTool",
    "shortDescription": "Gestor visual de proyectos locales",
    "longDescription": "Aplicación de escritorio para gestionar proyectos de desarrollo de manera eficiente. Incluye organización de proyectos, sistema de diario, TODOs, analytics, integración con Git, atajos de teclado y más.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "es-ES",
        "template": null,
        "fragmentPaths": [],
        "componentRefs": [],
        "featureGroupRefs": [],
        "featureRefs": [],
        "mergeRefs": [],
        "enableElevatedUpdateTask": false,
        "bannerPath": null,
        "dialogImagePath": null
      },
      "nsis": {
        "headerImage": null,
        "sidebarImage": null,
        "installerIcon": null,
        "installMode": "perMachine",
        "languages": ["es-ES", "en-US"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "template": null
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false
    }
  },
  "plugins": {}
}
